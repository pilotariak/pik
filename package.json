{
  "name": "pik",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "wrangler dev --persist-to .wrangler/state",
    "deploy": "wrangler deploy",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "migrate:local": "wrangler d1 migrations apply pilotariak-pik --local --persist-to .wrangler/state",
    "migrate:remote": "wrangler d1 migrations apply pilotariak-pik --remote",
    "migrate:list": "wrangler d1 migrations list pilotariak-pik --local --persist-to .wrangler/state",
    "db:local": "wrangler d1 execute pilotariak-pik --local --persist-to .wrangler/state --command",
    "db:remote": "wrangler d1 execute pilotariak-pik --remote --command"
  },
  "devDependencies": {
    "miniflare": "5.20261113.0-beta",
    "wrangler": "4.162.0"
  }
}
